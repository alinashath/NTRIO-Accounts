# Copy to server/.env
# Pooled — Prisma at runtime (Supabase “Transaction” / port 6543; often needs ?pgbouncer=true)
DATABASE_URL=
# Migrations — use the dashboard “Direct connection” URI (host db.<ref>.supabase.co:5432, user postgres).
# If migrate still fails (P1001), see README: IPv6 / firewall / placeholder password.
# Append ?sslmode=require if not already in the string.
DIRECT_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# Optional — comma-separated. If set, only these Supabase auth emails may add/list users under Settings.
# SETTINGS_USER_ADMIN_EMAILS=you@company.com,other@company.com

# Railway: set VITE_* in the service so the client build embeds Supabase. If CLIENT_ORIGIN is unset,
# the API allows https://$RAILWAY_PUBLIC_DOMAIN when Railway injects it.
# Hard reset app tables (dev): from repo root `npm run db:nuke` uses DATABASE_URL + scripts/drop-app-tables.sql then db push

# Copy to client/.env (restart Vite after changes)
VITE_SUPABASE_URL=
# Prefer the “anon” / “public” JWT from API settings; or use publishable key name:
VITE_SUPABASE_ANON_KEY=
# Optional — REST API origin (no trailing slash). Use when the UI is not served from the same host as the API (e.g. phone on LAN, or production split). Example: http://localhost:3001 or https://api.yourdomain.com
# VITE_API_BASE_URL=http://localhost:3001
# VITE_SUPABASE_PUBLISHABLE_KEY=   # optional alternative if your dashboard only shows this
# Optional — Supabase Storage bucket for receipt uploads (default: receipts). Bucket should be public-read or use signed URLs later.
# VITE_SUPABASE_RECEIPTS_BUCKET=receipts

# Optional (plan)
SUPABASE_STORAGE_BUCKET=receipts
JWT_SECRET=
