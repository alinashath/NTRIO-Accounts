generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Shared workspace / brand for a set of app users (Settings → App users).
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  title     String   @default("NTRIO") @db.VarChar(64)
  /// Enabled workspace modules for this tenant (accounts | occupancy | kitchen | stock).
  enabledModules String[] @default(["accounts", "occupancy", "kitchen", "stock"]) @map("enabled_modules")
  /// Maldives GST TIN (taxpayer identification number).
  gstTin String? @map("gst_tin") @db.VarChar(64)
  /// Legal / registered name on the GST certificate (if different from title).
  gstRegisteredName String? @map("gst_registered_name") @db.VarChar(160)
  /// Currency used when preparing the GST return (typically MVR).
  gstReturnCurrency String @default("MVR") @map("gst_return_currency") @db.VarChar(8)
  /// Taxable activities from the GST registration certificate: [{ number, name? }].
  taxableActivities Json @default("[]") @map("taxable_activities")
  /// When true, GST invoice wizards can optionally capture Maldives Green Tax.
  greenTaxEnabled Boolean @default(false) @map("green_tax_enabled")
  /// When true (and green tax enabled), income Green Tax step collects guest rows for the MIRA Information Sheet.
  greenTaxCollectGuests Boolean @default(false) @map("green_tax_collect_guests")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Users whose last-selected / default workspace is this org.
  activeUsers User[]             @relation("UserActiveOrganization")
  members     OrganizationMember[]

  @@map("organizations")
}

/// Many-to-many: one login can belong to multiple organizations.
model OrganizationMember {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_members")
}

enum OrgSetupRequestStatus {
  pending
  approved
  rejected
}

/// New-tenant signup: organization setup must be approved by the system admin.
model OrganizationSetupRequest {
  id                   String                @id @default(uuid()) @db.Uuid
  requesterUserId      String                @map("requester_user_id") @db.Uuid
  requesterEmail       String                @map("requester_email")
  organizationTitle    String                @map("organization_title") @db.VarChar(64)
  contactName          String?               @map("contact_name") @db.VarChar(120)
  status               OrgSetupRequestStatus @default(pending)
  rejectionReason      String?               @map("rejection_reason")
  reviewedByEmail      String?               @map("reviewed_by_email")
  reviewedAt           DateTime?             @map("reviewed_at")
  createdOrganizationId String?              @map("created_organization_id") @db.Uuid
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  requester User @relation(fields: [requesterUserId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([requesterUserId])
  @@map("organization_setup_requests")
}

/// Application user profile keyed to Supabase Auth `auth.users.id`
model User {
  id             String   @id @db.Uuid
  email          String?
  /// Last selected organization (workspace) for this login.
  organizationId String?  @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  organization        Organization? @relation("UserActiveOrganization", fields: [organizationId], references: [id], onDelete: SetNull)
  memberships         OrganizationMember[]
  orgSetupRequests    OrganizationSetupRequest[]
  accounts            Account[]
  categories          Category[]
  incomeEntries       IncomeEntry[]
  expenseEntries      ExpenseEntry[]
  recurringSchedules  RecurringSchedule[]
  debts               Debt[]
  accountTransfers    AccountTransfer[]
  contacts            Contact[]
  settings            UserSettings?
  fxDailyRates        FxDailyRate[]
  accountBalanceAdjustments AccountBalanceAdjustment[]
  projects            Project[]
  rooms               Room[]
  roomDays            RoomDay[]
  roomStays           RoomStay[]
  breakfastOrders     BreakfastOrder[]
  roomDayExtras       RoomDayExtras[]
  stockItems          StockItem[]
  stockLedgerDays     StockLedgerDay[]
  stockProducts       StockProduct[]
  recipes             Recipe[]
  mealMenus           MealMenu[]

  @@index([organizationId])
  @@map("users")
}

/// Per-user preferences (FX for display and defaults).
model UserSettings {
  userId           String   @id @map("user_id") @db.Uuid
  /// MVR units per 1 USD (same convention as account transfers). Current / latest rate.
  globalUsdMvrRate Decimal  @default(20) @map("global_usd_mvr_rate") @db.Decimal(18, 8)
  /// Wordmark shown in TopBar / Hub (e.g. NTRIO).
  organizationTitle String  @default("NTRIO") @map("organization_title") @db.VarChar(64)
  /// When true, project tagging and filters are available across accounts.
  projectsEnabled  Boolean  @default(false) @map("projects_enabled")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

/// Optional named project for tagging income/expense (Settings → Projects).
model Project {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomeEntries  IncomeEntry[]
  expenseEntries ExpenseEntry[]

  @@index([userId])
  @@map("projects")
}

/// Sparse daily USD↔MVR rate history. A rate on date D applies until the next saved rate.
model FxDailyRate {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  rateDate    DateTime @map("rate_date") @db.Date
  /// MVR units per 1 USD.
  usdMvrRate  Decimal  @map("usd_mvr_rate") @db.Decimal(18, 8)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, rateDate])
  @@index([userId, rateDate])
  @@map("fx_daily_rates")
}

enum ContactKind {
  vendor
  customer
  other
}

model Contact {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  name      String
  kind      ContactKind @default(other)
  email     String?
  phone     String?
  /// Tax registration (e.g. TGST / GST-style number).
  tgstNumber String?    @map("tgst_number")
  notes     String?
  createdAt DateTime    @default(now()) @map("created_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomeEntries  IncomeEntry[]
  expenseEntries ExpenseEntry[]
  debts          Debt[]

  @@index([userId])
  @@index([userId, kind])
  @@map("contacts")
}

enum AccountType {
  bank
  cash
  wallet
}

model Account {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  name      String
  type      AccountType
  currency        String      @default("USD")
  openingBalance  Decimal     @default(0) @map("opening_balance") @db.Decimal(15, 2)
  balance         Decimal     @default(0) @db.Decimal(15, 2)
  openedAt        DateTime?   @map("opened_at") @db.Date
  createdAt DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  incomeFromAccount IncomeEntry[]      @relation("IncomeAccount")
  expenseFromAccount ExpenseEntry[]    @relation("ExpenseAccount")
  debtPayments      DebtPayment[]
  transfersFrom     AccountTransfer[] @relation("TransferFrom")
  transfersTo       AccountTransfer[]   @relation("TransferTo")
  balanceAdjustments AccountBalanceAdjustment[]

  @@index([userId])
  @@map("accounts")
}

/// Manual reconciliation deltas (bank fees, rounding, true-up). Positive increases account balance.
model AccountBalanceAdjustment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  date      DateTime @db.Date
  amount    Decimal  @db.Decimal(15, 2)
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, date])
  @@index([userId, accountId])
  @@map("account_balance_adjustments")
}

enum CategoryKind {
  income
  expense
}

model Category {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  name      String
  type      CategoryKind
  color     String?
  icon      String?
  budgetLimit Decimal?   @map("budget_limit") @db.Decimal(15, 2)
  createdAt DateTime     @default(now()) @map("created_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomeEntries  IncomeEntry[]
  expenseEntries ExpenseEntry[]
  expenseSplits  ExpenseSplit[]

  @@index([userId, type])
  @@map("categories")
}

enum RecurringType {
  income
  expense
}

enum RecurringFrequency {
  daily
  weekly
  fortnightly
  monthly
  quarterly
  annually
}

model RecurringSchedule {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  type      RecurringType
  frequency RecurringFrequency
  nextDate  DateTime?          @map("next_date") @db.Date
  endDate   DateTime?          @map("end_date") @db.Date
  isActive  Boolean            @default(true) @map("is_active")
  template  Json

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomeEntries IncomeEntry[]
  expenseEntries ExpenseEntry[]

  @@index([userId])
  @@map("recurring_schedules")
}

model IncomeEntry {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  amount         Decimal   @db.Decimal(15, 2)
  /// Earned / invoice date (accrual).
  date           DateTime  @db.Date
  /// When deposited to `account`; null while receivable (no account yet).
  receivedDate DateTime? @map("received_date") @db.Date
  /// Currency of `amount` (must match account when deposited).
  currency       String    @default("USD")
  description    String?
  categoryId     String?   @map("category_id") @db.Uuid
  projectId      String?   @map("project_id") @db.Uuid
  accountId      String?   @map("account_id") @db.Uuid
  source         String?
  notes          String?
  tags           String[]  @default([])
  attachmentUrl  String?   @map("attachment_url")
  contactId      String?   @map("contact_id") @db.Uuid
  /// Optional tax invoice number (MIRA-style).
  invoiceNumber  String?   @map("invoice_number") @db.VarChar(64)
  /// GST percent (e.g. 8.00). Null when no tax breakdown.
  gstRate        Decimal?  @map("gst_rate") @db.Decimal(5, 2)
  /// Value of supplies subject to GST (excl. tax).
  gstSubtotal    Decimal?  @map("gst_subtotal") @db.Decimal(15, 2)
  /// Tax charged (auto or manual).
  gstAmount      Decimal?  @map("gst_amount") @db.Decimal(15, 2)
  /// Value of zero-rated supplies.
  zeroRatedAmount Decimal? @map("zero_rated_amount") @db.Decimal(15, 2)
  /// Maldives Green Tax amount (excluded from GST taxable subtotal).
  greenTaxAmount Decimal? @map("green_tax_amount") @db.Decimal(15, 2)
  greenTaxCheckIn DateTime? @map("green_tax_check_in")
  greenTaxCheckOut DateTime? @map("green_tax_check_out")
  /// Uploaded MIRA 501 / Information Sheet (or paste URL).
  greenTaxFormUrl String? @map("green_tax_form_url") @db.VarChar(2048)
  /// Guest rows for MIRA Green Tax Information Sheet: [{ guest_reg_no, name, category, identification_no, nationality, booking_method }].
  greenTaxGuests Json @default("[]") @map("green_tax_guests")
  voidedAt       DateTime? @map("voided_at")
  voidReason     String?   @map("void_reason")
  recurringId    String?   @map("recurring_id") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  project   Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  account   Account?           @relation("IncomeAccount", fields: [accountId], references: [id], onDelete: Restrict)
  contact   Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  recurring RecurringSchedule? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, receivedDate])
  @@index([accountId])
  @@index([contactId])
  @@index([projectId])
  @@map("income_entries")
}

model ExpenseEntry {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  amount         Decimal   @db.Decimal(15, 2)
  /// Legacy sort/filter date; kept in sync as COALESCE(paid_date, bill_date) on write.
  date           DateTime  @db.Date
  /// Vendor / statement date.
  billDate       DateTime  @map("bill_date") @db.Date
  /// Cash-out date (null while pay_later unpaid).
  paidDate       DateTime? @map("paid_date") @db.Date
  description    String?
  categoryId     String?   @map("category_id") @db.Uuid
  projectId      String?   @map("project_id") @db.Uuid
  accountId      String?   @map("account_id") @db.Uuid
  debtId         String?   @map("debt_id") @db.Uuid
  merchant       String?
  notes          String?
  tags           String[]  @default([])
  attachmentUrl  String?   @map("attachment_url")
  contactId      String?   @map("contact_id") @db.Uuid
  /// Optional tax invoice number (MIRA-style).
  invoiceNumber  String?   @map("invoice_number") @db.VarChar(64)
  /// GST percent (e.g. 8.00). Null when no tax breakdown.
  gstRate        Decimal?  @map("gst_rate") @db.Decimal(5, 2)
  /// Value of supplies subject to GST (excl. tax).
  gstSubtotal    Decimal?  @map("gst_subtotal") @db.Decimal(15, 2)
  /// Tax charged (auto or manual).
  gstAmount      Decimal?  @map("gst_amount") @db.Decimal(15, 2)
  /// Value of zero-rated supplies.
  zeroRatedAmount Decimal? @map("zero_rated_amount") @db.Decimal(15, 2)
  /// Maldives Green Tax amount (excluded from GST taxable subtotal).
  greenTaxAmount Decimal? @map("green_tax_amount") @db.Decimal(15, 2)
  greenTaxCheckIn DateTime? @map("green_tax_check_in")
  greenTaxCheckOut DateTime? @map("green_tax_check_out")
  greenTaxFormUrl String? @map("green_tax_form_url") @db.VarChar(2048)
  voidedAt       DateTime? @map("voided_at")
  voidReason     String?   @map("void_reason")
  recurringId    String?   @map("recurring_id") @db.Uuid
  /// Unpaid bill: no bank account and no debt until settled from an account or charged to debt.
  payLater       Boolean   @default(false) @map("pay_later")
  /// Currency of `amount` when pay_later (defaults USD).
  billCurrency   String    @default("USD") @map("bill_currency")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  project   Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  account   Account?           @relation("ExpenseAccount", fields: [accountId], references: [id], onDelete: Restrict)
  debt      Debt?              @relation("ExpenseDebt", fields: [debtId], references: [id], onDelete: Restrict)
  contact   Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  recurring RecurringSchedule? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  splits    ExpenseSplit[]

  @@index([userId, date])
  @@index([accountId])
  @@index([debtId])
  @@index([contactId])
  @@index([userId, payLater])
  @@index([projectId])
  @@map("expense_entries")
}

model ExpenseSplit {
  id         String  @id @default(uuid()) @db.Uuid
  expenseId  String  @map("expense_id") @db.Uuid
  categoryId String  @map("category_id") @db.Uuid
  amount     Decimal @db.Decimal(15, 2)
  percentage Decimal? @db.Decimal(5, 2)

  expense  ExpenseEntry @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  category Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([expenseId])
  @@map("expense_splits")
}

enum DebtDirection {
  i_owe
  owed_to_me
}

enum DebtStatus {
  open
  settled
}

model Debt {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  direction     DebtDirection
  contactName   String        @map("contact_name")
  /// Optional link to a row on the Contacts page (counterparty label stays in `contactName`).
  contactId     String?       @map("contact_id") @db.Uuid
  principal     Decimal       @db.Decimal(15, 2)
  currency      String        @default("USD")
  interestRate  Decimal       @default(0) @map("interest_rate") @db.Decimal(5, 2)
  dueDate       DateTime?     @map("due_date") @db.Date
  notes         String?
  status        DebtStatus    @default(open)
  createdAt     DateTime      @default(now()) @map("created_at")

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact         Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  payments        DebtPayment[]
  expenseAccruals ExpenseEntry[] @relation("ExpenseDebt")

  @@index([userId, status])
  @@index([contactId])
  @@map("debts")
}

model DebtPayment {
  id            String    @id @default(uuid()) @db.Uuid
  debtId        String    @map("debt_id") @db.Uuid
  accountId     String    @map("account_id") @db.Uuid
  /// Reduction toward the debt, always in the debt's `currency`.
  amount        Decimal   @db.Decimal(15, 2)
  /// Cash debited from `account` when in a different currency than the debt; otherwise null (use `amount`).
  accountAmount Decimal?  @map("account_amount") @db.Decimal(15, 2)
  /// Debt-currency units per 1 account-currency unit (when cross-currency).
  exchangeRate  Decimal?  @map("exchange_rate") @db.Decimal(18, 8)
  date          DateTime  @db.Date
  notes         String?
  attachmentUrl String?   @map("attachment_url")
  voidedAt      DateTime? @map("voided_at")
  voidReason    String?   @map("void_reason")
  createdAt     DateTime  @default(now()) @map("created_at")

  debt    Debt    @relation(fields: [debtId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([debtId])
  @@map("debt_payments")
}

model AccountTransfer {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  fromAccountId String    @map("from_account_id") @db.Uuid
  toAccountId   String    @map("to_account_id") @db.Uuid
  amount        Decimal   @db.Decimal(15, 2)
  /// Units of *to* currency per 1 unit of *from* currency (when currencies differ). Null = same currency (treated as 1).
  exchangeRate  Decimal?  @map("exchange_rate") @db.Decimal(18, 8)
  date          DateTime  @db.Date
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount Account @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount   Account @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)

  @@index([userId, date])
  @@map("account_transfers")
}

// ─── Kitchen / Stock (Isola Alifu breakfast ops) ─────────────────────────────

enum BreakfastType {
  maldivian
  continental
}

enum EggStyle {
  omelette
  fried
  boiled
  scrambled
}

enum BreakfastOrderStatus {
  pending
  served
  cancelled
}

enum MealPeriod {
  breakfast
  lunch
  dinner
}

enum StockItemKind {
  kitchen
  other
}

model Room {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  number    String
  createdAt DateTime @default(now()) @map("created_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomDays        RoomDay[]
  roomStays       RoomStay[]
  breakfastOrders BreakfastOrder[]
  roomDayExtras   RoomDayExtras[]

  @@unique([userId, number])
  @@index([userId])
  @@map("rooms")
}

/// Guest stay with from/to dates; fills RoomDay occupancy for each date in range.
model RoomStay {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  roomId        String   @map("room_id") @db.Uuid
  fromDate      DateTime @map("from_date") @db.Date
  toDate        DateTime @map("to_date") @db.Date
  occupantCount Int      @default(1) @map("occupant_count")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([userId, fromDate, toDate])
  @@index([userId, roomId])
  @@map("room_stays")
}

/// Manual occupancy for a room on a date (occupant count). Breakfast is separate via orders.
model RoomDay {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  roomId        String   @map("room_id") @db.Uuid
  date          DateTime @db.Date
  occupantCount Int      @default(0) @map("occupant_count")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId, date])
  @@index([userId, date])
  @@map("room_days")
}

/// Per-guest meal order (breakfast / lunch / dinner). Table name kept for migration continuity.
model BreakfastOrder {
  id                   String                @id @default(uuid()) @db.Uuid
  userId               String                @map("user_id") @db.Uuid
  roomId               String                @map("room_id") @db.Uuid
  breakfastDate        DateTime              @map("breakfast_date") @db.Date
  mealPeriod           MealPeriod            @default(breakfast) @map("meal_period")
  guestNumber          Int                   @map("guest_number")
  /// HH:mm local serving time
  servingTime          String                @map("serving_time")
  outsideNormalWindow  Boolean               @default(false) @map("outside_normal_window")
  /// Preferred: configurable meal menu. Legacy breakfastType used when null.
  menuId               String?               @map("menu_id") @db.Uuid
  /// @deprecated Prefer menuId
  breakfastType        BreakfastType         @map("breakfast_type")
  /// @deprecated Prefer selectedChoiceIds.egg_style
  eggStyle             EggStyle              @map("egg_style")
  /// Maldivian optional stir-fried potato
  potato               Boolean               @default(false)
  juice                Boolean               @default(false)
  tea                  Boolean               @default(false)
  coffee               Boolean               @default(false)
  milk                 Boolean               @default(false)
  sugar                Boolean               @default(false)
  /// Selected optional side / add-on menu-line or stock-item ids.
  selectedOptionIds    String[]              @default([]) @map("selected_option_ids")
  /// { [choiceGroupKey]: mealMenuLineId } — pick exactly one per group.
  selectedChoiceIds    Json                  @default("{}") @map("selected_choice_ids")
  specialRequests      String?               @map("special_requests")
  status               BreakfastOrderStatus  @default(pending)
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  menu MealMenu? @relation(fields: [menuId], references: [id], onDelete: SetNull)

  @@unique([userId, roomId, breakfastDate, mealPeriod, guestNumber])
  @@index([userId, breakfastDate])
  @@index([userId, breakfastDate, mealPeriod])
  @@map("breakfast_orders")
}

/// Per-room fruits and extras for a date + meal (breakfast / lunch / dinner).
model RoomDayExtras {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  roomId       String   @map("room_id") @db.Uuid
  date         DateTime @db.Date
  /// Independent fruits/extras bag for this meal period.
  mealPeriod   MealPeriod @default(breakfast) @map("meal_period")
  /// Subset of: watermelon, apple, papaya, orange (2–3 types)
  fruits       String[] @default([])
  /// Stock item ids selected from room_extras recipe lines (legacy; prefer selectedLines).
  selectedItemIds String[] @default([]) @map("selected_item_ids")
  /// [{ stock_item_id, quantity }] — room extras with qty in stock units.
  selectedLines Json @default("[]") @map("selected_lines")
  pancake      Boolean  @default(false)
  honey        Boolean  @default(false)
  nutella      Boolean  @default(false)
  cereal       Boolean  @default(false)
  waterBottle  Boolean  @default(false) @map("water_bottle")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId, date, mealPeriod])
  @@index([userId, date])
  @@map("room_day_extras")
}

model StockItem {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  /// Stable key for recipe math (e.g. flour, eggs); null for custom non-food items
  code        String?
  name        String
  /// Display label for the preferred unit (kept for list copy).
  unit        String
  /// Lowest storage unit: g | ml | pcs
  baseUnit    String        @default("pcs") @map("base_unit")
  /// Preferred UI unit code (kg, L, can, slice, …)
  displayUnit String        @default("pcs") @map("display_unit")
  /// JSON StockUnitDef[] — standard + pack units with to_base factors
  units       Json          @default("[]")
  kind        StockItemKind @default(kitchen)
  /// Min stock in base units
  minStock    Decimal       @default(0) @map("min_stock") @db.Decimal(15, 4)
  /// Latest price per base unit from a refill — used for meal cost estimates.
  lastUnitCost Decimal?     @map("last_unit_cost") @db.Decimal(18, 8)
  /// Human-readable Use rules from PDF
  useNotes    String?       @map("use_notes")
  /// Optional pack size info (legacy human note)
  packInfo    String?       @map("pack_info")
  sortOrder   Int           @default(0) @map("sort_order")
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerDays  StockLedgerDay[]
  recipeLines RecipeLine[]
  menuLines   MealMenuLine[]
  products    StockProduct[]

  @@unique([userId, code])
  @@index([userId, kind])
  @@map("stock_items")
}

/// Buyable product that refills one stock item by a fixed amount.
model StockProduct {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  stockItemId  String   @map("stock_item_id") @db.Uuid
  name         String
  description  String?
  /// How much one product adds, in `unitCode` (converted to base on refill).
  qty          Decimal  @db.Decimal(15, 4)
  unitCode     String   @map("unit_code")
  /// Optional suggested price per one product (currency).
  defaultPrice Decimal? @map("default_price") @db.Decimal(15, 2)
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stockItemId])
  @@map("stock_products")
}

/// Recipe linked to breakfast menu type or a custom named recipe.
enum RecipeApplyTo {
  maldivian
  continental
  room_extras
  custom
}

/// prepared = BOM for menu lines; addons = shared room extras; menu_legacy = old apply_to menus.
enum RecipeKind {
  menu_legacy
  prepared
  addons
}

enum MealMenuLineRole {
  base
  option
  choice
}

model Recipe {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  name        String
  applyTo     RecipeApplyTo  @default(custom) @map("apply_to")
  kind        RecipeKind     @default(menu_legacy)
  /// Optional stable code for seeded recipes (maldivian, continental, pancake, …)
  code        String?
  notes       String?
  /// When > 1, BOM is sized for this many servings/pieces (e.g. pancake batter = 20).
  batchSize   Int            @default(1) @map("batch_size")
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines             RecipeLine[]   @relation("RecipeOwnLines")
  componentOfLines  RecipeLine[]   @relation("RecipeLineComponent")
  menuLines         MealMenuLine[] @relation("MenuLineComponentRecipe")

  @@unique([userId, code])
  @@index([userId, applyTo])
  @@index([userId, kind])
  @@map("recipes")
}

model RecipeLine {
  id          String  @id @default(uuid()) @db.Uuid
  recipeId    String  @map("recipe_id") @db.Uuid
  stockItemId String  @map("stock_item_id") @db.Uuid
  /// Quantity in base units per one serving / one room-extras application (or per batch when recipe.batchSize > 1)
  qtyPerServing Decimal @map("qty_per_serving") @db.Decimal(15, 4)
  /// Qty as entered in the editor (e.g. 0.5)
  inputQty    Decimal? @map("input_qty") @db.Decimal(15, 4)
  /// Unit code chosen in the editor (e.g. can, g)
  inputUnit   String?  @map("input_unit")
  notes       String?
  /// When true and this extra is selected for a room, include it on KOT / kitchen plan.
  showOnKot   Boolean @default(true) @map("show_on_kot")
  /// When true on maldivian/continental recipes: choosable side on the order form (not always included).
  isOption    Boolean @default(false) @map("is_option")
  /// When set (addons / extras), selecting this line expands the prepared recipe BOM
  /// using qty ÷ recipe.batchSize instead of depleting the marker stock item.
  componentRecipeId String? @map("component_recipe_id") @db.Uuid

  recipe          Recipe  @relation("RecipeOwnLines", fields: [recipeId], references: [id], onDelete: Cascade)
  stockItem       StockItem @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  componentRecipe Recipe? @relation("RecipeLineComponent", fields: [componentRecipeId], references: [id], onDelete: SetNull)

  @@index([recipeId])
  @@index([componentRecipeId])
  @@map("recipe_lines")
}

/// Configurable meal menu for a period (e.g. Maldivian breakfast, Lunch set A).
model MealMenu {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  mealPeriod MealPeriod @map("meal_period")
  name       String
  code       String?
  notes      String?
  sortOrder  Int        @default(0) @map("sort_order")
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines  MealMenuLine[]
  orders BreakfastOrder[]

  @@unique([userId, code])
  @@index([userId, mealPeriod])
  @@map("meal_menus")
}

model MealMenuLine {
  id                 String           @id @default(uuid()) @db.Uuid
  menuId             String           @map("menu_id") @db.Uuid
  role               MealMenuLineRole @default(base)
  /// Required when role = choice (e.g. egg_style).
  choiceGroupKey     String?          @map("choice_group_key")
  choiceGroupLabel   String?          @map("choice_group_label")
  /// Display name on order form / KOT (falls back to stock or recipe name).
  displayName        String?          @map("display_name")
  stockItemId        String?          @map("stock_item_id") @db.Uuid
  componentRecipeId  String?          @map("component_recipe_id") @db.Uuid
  qtyPerServing      Decimal          @default(1) @map("qty_per_serving") @db.Decimal(15, 4)
  notes              String?
  showOnKot          Boolean          @default(true) @map("show_on_kot")
  sortOrder          Int              @default(0) @map("sort_order")

  menu            MealMenu  @relation(fields: [menuId], references: [id], onDelete: Cascade)
  stockItem       StockItem? @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  componentRecipe Recipe?   @relation("MenuLineComponentRecipe", fields: [componentRecipeId], references: [id], onDelete: Restrict)

  @@index([menuId])
  @@map("meal_menu_lines")
}

/// Daily inventory ledger: Opening, Received, Used, Balance, expenditure, waste.
model StockLedgerDay {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  stockItemId  String   @map("stock_item_id") @db.Uuid
  date         DateTime @db.Date
  opening      Decimal  @default(0) @db.Decimal(15, 4)
  received     Decimal  @default(0) @db.Decimal(15, 4)
  used         Decimal  @default(0) @db.Decimal(15, 4)
  /// Food waste quantity (for reporting)
  waste        Decimal  @default(0) @db.Decimal(15, 4)
  /// Expenditure for received goods on this date (currency units)
  expenditure  Decimal  @default(0) @db.Decimal(15, 2)
  /// Price per base unit recorded on this day's refill
  unitCost     Decimal? @map("unit_cost") @db.Decimal(18, 8)
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@unique([userId, stockItemId, date])
  @@index([userId, date])
  @@map("stock_ledger_days")
}
