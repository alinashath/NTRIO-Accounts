NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Prefer legacy anon JWT (Settings → API → anon public) — most reliable for auth/middleware
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Or newer publishable key (Settings → API → publishable)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# For npm run db:migrate (pick one):
# SUPABASE_ACCESS_TOKEN=sbp_...     ← supabase.com/dashboard/account/tokens
# SUPABASE_DB_PASSWORD=...          ← Project Settings → Database password
